#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <string.h>
#include <sys/types.h>
#include <sys/wait.h>

int main()
{
   int pipe1[2];
   int pipe2[2];
   pid_t pid2, pid3;
   if (pipe(pipe1) == -1 || pipe(pipe2) == -1)
   {
      perror("Pipe Creation Failed");
      return 1;
   }

   pid2 = fork();
   if (pid2 < 0)
   {
      perror("Process Failed");
   }
   else if (pid2 == 0)
   {
      pid3 = fork();
      if (pid3 < 0)
      {
         perror("Process Failed");
      }
      else if (pid3 == 0)
      {
         char p3_str[100];
         int l = 0, h;
         int isPalin = 1;
         close(pipe1[0]); close(pipe1[1]);
         close(pipe2[1]);
         read(pipe2[0], p3_str, 100);
         close(pipe2[0]);
         h = strlen(p3_str) - 1;
         while (h > l)
         {
            if (p3_str[l++] != p3_str[h--])
            {
               isPalin = 0;
               break;
            }
         }

         printf("P3: Received String = %s\n", p3_str);
         if (isPalin == 1)
         {
            printf("P3: Result = The string is a Palindrome.\n");
         }
         else
         {
            printf("P3: Result = The string is NOT a Palindrome.\n");
         }
      }
      else
      {
         char p2_str[100];
         int vowel_count = 0, i;
         close(pipe1[1]);
         close(pipe2[0]);
         read(pipe1[0], p2_str, 100);
         close(pipe1[0]);
         for (i = 0; p2_str[i] != '\0'; i++)
         {
            char ch = p2_str[i];
            if (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u' ||
                ch == 'A' || ch == 'E' || ch == 'I' || ch == 'O' || ch == 'U')
            {
               vowel_count++;
            }
         }

         printf("P2: Received String = %s\n", p2_str);
         printf("P2: Number of Vowels = %d\n", vowel_count);
         write(pipe2[1], p2_str, strlen(p2_str) + 1);
         close(pipe2[1]);
         wait(NULL);
      }
   }
   else
   {
      char input_str[100];
      close(pipe1[0]);
      close(pipe2[0]); close(pipe2[1]);

      printf("P1: Enter a string: ");
      fgets(input_str, 100, stdin);
      input_str[strcspn(input_str, "\n")] = '\0';
      write(pipe1[1], input_str, strlen(input_str) + 1);
      close(pipe1[1]);
      wait(NULL);
   }
   return 0;
}
