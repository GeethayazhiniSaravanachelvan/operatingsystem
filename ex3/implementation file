/* ================= ROUND ROBIN - PREEMPTIVE (standard RR) ================= */
void roundRobinPreemptive()
{
    int n, i;
    int at[10], bt[10], rt[10];
    int ct[10], tat[10], wt[10];
    int tq, time = 0, completed = 0;
    int flag;
    float avgWT = 0, avgTAT = 0;

    printf("\n========== Round Robin Scheduling (Preemptive) ==========\n");

    printf("Enter the number of processes: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        printf("\nEnter Arrival Time and Burst Time of Process %d: ", i + 1);
        scanf("%d%d", &at[i], &bt[i]);

        rt[i] = bt[i];
    }

    printf("\nEnter Time Quantum: ");
    scanf("%d", &tq);

    while(completed < n)
    {
        flag = 0;

        for(i = 0; i < n; i++)
        {
            if(at[i] <= time && rt[i] > 0)
            {
                flag = 1;

                if(rt[i] > tq)
                {
                    time = time + tq;
                    rt[i] = rt[i] - tq;
                }
                else
                {
                    time = time + rt[i];
                    rt[i] = 0;

                    ct[i] = time;
                    tat[i] = ct[i] - at[i];
                    wt[i] = tat[i] - bt[i];

                    if(wt[i] < 0)
                        wt[i] = 0;

                    avgTAT += tat[i];
                    avgWT += wt[i];

                    completed++;
                }
            }
        }

        if(flag == 0)
        {
            time++;
        }
    }

    avgTAT /= n;
    avgWT /= n;

    printf("\n---------------------------------------------------------");
    printf("\nProcess\tAT\tBT\tCT\tTAT\tWT");
    printf("\n---------------------------------------------------------");

    for(i = 0; i < n; i++)
    {
        printf("\nP%d\t%d\t%d\t%d\t%d\t%d",
               i + 1, at[i], bt[i], ct[i], tat[i], wt[i]);
    }

    printf("\n---------------------------------------------------------");
    printf("\nAverage Turnaround Time = %.2f", avgTAT);
    printf("\nAverage Waiting Time = %.2f\n", avgWT);
}


/* ================= ROUND ROBIN - NON-PREEMPTIVE =================
   Processes are picked in circular/arrival order using the ready
   queue like normal RR, but once a process is dispatched on the CPU
   it is allowed to run to completion (no preemption at quantum
   expiry). Time Quantum is still taken as input (as commonly asked
   in lab exercises) but is not used to cut a running process short.
*/
void roundRobinNonPreemptive()
{
    int n, i;
    int at[10], bt[10];
    int ct[10], tat[10], wt[10];
    int completed[10] = {0};
    int queue[10], front = 0, rear = 0;
    int inQueue[10] = {0};
    int tq, time = 0, count = 0;

    float avgWT = 0, avgTAT = 0;

    printf("\n========== Round Robin Scheduling (Non-Preemptive) ==========\n");

    printf("Enter the number of processes: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        printf("\nEnter Arrival Time and Burst Time of Process %d: ", i + 1);
        scanf("%d%d", &at[i], &bt[i]);
    }

    printf("\nEnter Time Quantum: ");
    scanf("%d", &tq);   /* accepted for consistency, not used to preempt */

    time = 9999;
    for(i = 0; i < n; i++)
        if(at[i] < time)
            time = at[i];

    while(count < n)
    {
        /* push all processes that have arrived and are not queued/completed */
        for(i = 0; i < n; i++)
        {
            if(at[i] <= time && !inQueue[i] && !completed[i])
            {
                queue[rear++] = i;
                inQueue[i] = 1;
            }
        }

        if(front == rear)
        {
            time++;
            continue;
        }

        int idx = queue[front++];

        /* run process to completion (non-preemptive) */
        if(time < at[idx])
            time = at[idx];

        time = time + bt[idx];

        ct[idx] = time;
        tat[idx] = ct[idx] - at[idx];
        wt[idx] = tat[idx] - bt[idx];

        avgTAT += tat[idx];
        avgWT += wt[idx];

        completed[idx] = 1;
        count++;

        /* enqueue any new arrivals that came in during this burst */
        for(i = 0; i < n; i++)
        {
            if(at[i] <= time && !inQueue[i] && !completed[i])
            {
                queue[rear++] = i;
                inQueue[i] = 1;
            }
        }
    }

    avgTAT /= n;
    avgWT /= n;

    printf("\n---------------------------------------------------------");
    printf("\nProcess\tAT\tBT\tCT\tTAT\tWT");
    printf("\n---------------------------------------------------------");

    for(i = 0; i < n; i++)
    {
        printf("\nP%d\t%d\t%d\t%d\t%d\t%d",
               i + 1, at[i], bt[i], ct[i], tat[i], wt[i]);
    }

    printf("\n---------------------------------------------------------");
    printf("\nAverage Turnaround Time = %.2f", avgTAT);
    printf("\nAverage Waiting Time = %.2f\n", avgWT);
}


