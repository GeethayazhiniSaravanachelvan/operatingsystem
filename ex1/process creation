#include<stdio.h>
#include<unistd.h>
#include<sys/wait.h>
int main()
{
   pid_t        pid2;
   pid2=fork();
   if(pid2==0)
   {
      printf("Process 2 pid2=%d,parent ppid=%d\n",getpid(),getppid());
   }
   else if (pid2>0){
      wait(NULL);
      printf("Process1 pid1=%d,parent ppid=%d\n",getpid(),getppid());
   }
   else{
      perror("No process");
   }
   return 0;
}
