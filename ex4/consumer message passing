#include <stdio.h>
#include <sys/ipc.h>
#include <sys/msg.h>
struct message {
long type;
char text[500];
};
int main()
{
key_t key;
int msgid;
FILE *fp;
struct message msg;
key = ftok("filemsg", 65);
if (key == -1) { perror("ftok"); return 1; }
msgid = msgget(key, 0666 | IPC_CREAT);
if (msgid == -1) { perror("msgget"); return 1; }
if (msgrcv(msgid, &msg, sizeof(msg.text), 1, 0) == -1) {
perror("msgrcv failed");
return 1;
}
fp = fopen("filecopy.txt", "w");
if(fp == NULL) {
printf("Cannot create output file.\n");
return 1;
}
fprintf(fp, "%s", msg.text);
fclose(fp);
printf("File copied successfully to filecopy.txt\n");
msgctl(msgid, IPC_RMID, NULL);
return 0;
}
