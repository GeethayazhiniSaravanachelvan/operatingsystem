
#include <stdio.h>
#include <sys/ipc.h>
#include <sys/shm.h>
int main()
{
   int i;
key_t key;
int shmid;
int *matrix_buf;
key = ftok("matrix", 65);
if (key == -1) { perror("ftok"); return 1; }
shmid = shmget(key, 8 * sizeof(int), 0666);
if (shmid == -1) { perror("shmget"); return 1; }
matrix_buf = (int *)shmat(shmid, NULL, 0);
if (matrix_buf == (int *)-1) { perror("shmat"); return 1; }
printf("\nMatrix A received:\n");
for( i = 0; i < 4; i++) {
printf("%d ", matrix_buf[i]);
if(i == 1) printf("\n");
}
printf("\n\nMatrix B received:\n");
for( i = 0; i < 4; i++) {
printf("%d ", matrix_buf[i + 4]);
if(i == 1) printf("\n");
}
printf("\n\nResultant Matrix Sum (1D Compute):\n");
for( i = 0; i < 4; i++) {
int sum = matrix_buf[i] + matrix_buf[i + 4];
printf("%d ", sum);
if(i == 1) printf("\n");
}
printf("\n");
shmdt(matrix_buf);
shmctl(shmid, IPC_RMID, NULL); // Free memory resource
return 0;
}
